# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Local PostgreSQL connection. Format:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://tppf_dev:tppf_dev_pw@localhost:5432/tppf_clinic_dev

# Which environment this is running in — affects logging verbosity etc.
NODE_ENV=development

# Port the Express server listens on.
PORT=3000

# Secret used to sign login tokens. Generate a real random value for actual
# use, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-value
JWT_EXPIRES_IN=12h
